# "seid" is the verb (ihr seid), "seit" the preposition of time. Only one
# direction is safely decidable without parsing: "seid" cannot be followed by a
# past or duration expression. The other direction is genuinely ambiguous — in
# "ihr seit Jahren bestehender Betrieb" the "seit" is correct — so it is left
# alone.
#
# Present-time words are deliberately absent: "Seid heute pünktlich!" is a
# perfectly good imperative.
expr zeitangabe [gestern, vorgestern, damals, langem, kurzem, jeher, neuestem, geraumer, jahren, monaten, wochen, tagen, jahrzehnten, jahrhunderten, generationen, menschengedenken, urzeiten, stunden, minuten, sekunden, ewigkeiten]

# A duration usually carries a number or a quantifier in front of the noun:
# "seid drei Jahren", "seid vielen Wochen", "seid einem Jahr". The verb "seid"
# cannot stand there either.
expr menge [zwei, drei, vier, fünf, sechs, sieben, acht, neun, zehn, elf, zwölf, zwanzig, dreißig, hundert, vielen, einigen, mehreren, wenigen, etlichen, zahlreichen, (ein paar), über, fast, knapp, gut]

expr einzahl [jahr, monat, tag, jahrzehnt, jahrhundert, woche, stunde, minute]

# "seid letzter Woche", "seid vergangenem Sommer": an inflected "letzt-" or
# "vergangen-" in the dative can only follow a preposition. As a predicate after
# the verb it is uninflected or nominalized: "ihr seid Letzte".
expr vergangen [letzter, letztem, vergangener, vergangenem, voriger, vorigem]

expr zeitraum [jahr, monat, tag, jahrzehnt, jahrhundert, woche, stunde, minute, sommer, winter, frühling, herbst, montag, dienstag, mittwoch, donnerstag, freitag, samstag, sonntag, wochenende, nacht, saison, jahrtausend]

# "Seid dem Umzug geht es mir besser": a dative phrase and then a finite verb.
# The imperative "seid" would itself be the verb, so a second one right after
# the phrase leaves only the preposition. "Seid dem Lehrer dankbar" has an
# adjective there and stays.
expr finit [ist, sind, war, waren, geht, ging, gibt, gab, hat, haben, hatte, habe, bin, lebe, lebt, leben, wohne, wohnt, wohnen, arbeite, arbeitet, arbeiten, kann, können, weiß, wissen, fühle, fühlt, regnet, läuft, hat, bleibt, fehlt, kenne, kennt]

expr main <[(seid [dem, der, einem, einer] * @finit), (seid @zeitangabe), (seid @menge @zeitangabe), (seid [einem, einer] @einzahl), (seid @vergangen @zeitraum)], seid>

let message "»seid« ist die Verbform (»ihr seid«). Vor einer Zeitangabe steht die Präposition »seit«."
let description "Ersetzt das Verb »seid« vor einer Zeitangabe durch die Präposition »seit«."
let kind "Grammar"
let becomes "seit"
let strategy "MatchCase"

test "Er wohnt seid gestern hier." "Er wohnt seit gestern hier."
test "Das Haus steht seid Jahren leer." "Das Haus steht seit Jahren leer."
test "Wir kennen uns seid Jahrzehnten." "Wir kennen uns seit Jahrzehnten."
test "Sie arbeitet dort seid langem." "Sie arbeitet dort seit langem."
test "Er trägt die Stiefel seid drei Jahren." "Er trägt die Stiefel seit drei Jahren."
test "Wir warten seid vielen Wochen." "Wir warten seit vielen Wochen."
test "Sie ist seid einem Jahr in der Schule." "Sie ist seit einem Jahr in der Schule."
test "Das Geschäft gibt es seid ein paar Monaten." "Das Geschäft gibt es seit ein paar Monaten."
test "Ich warte seid zwei Stunden." "Ich warte seit zwei Stunden."
test "Er wartet seid einer Stunde." "Er wartet seit einer Stunde."

test "Seid letzter Woche ist er krank." "Seit letzter Woche ist er krank."
test "Seid dem Umzug geht es mir besser." "Seit dem Umzug geht es mir besser."
test "Seid der Hochzeit wohnen sie in Bonn." "Seit der Hochzeit wohnen sie in Bonn."
test "Wir wohnen hier seid vergangenem Sommer." "Wir wohnen hier seit vergangenem Sommer."

allows "Ihr seid pünktlich gekommen."
allows "Seid dem Lehrer dankbar."
allows "Seid der Sache treu, ist sein Rat."
allows "Ihr seid Letzte geworden."
allows "Seit letzter Woche ist er krank."
allows "Seid heute bitte pünktlich."
allows "Das Haus steht seit Jahren leer."
allows "Seid ihr schon da?"
allows "Ihr seid drei Freunde."
allows "Ihr seid einer Meinung."
allows "Ihr seid vielen Menschen begegnet."
allows "Er trägt die Stiefel seit drei Jahren."
