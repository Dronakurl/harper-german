# "Ich interessiere mir für Kunst": these verbs take the reflexive pronoun in the
# accusative, so "mich", not "mir". Only verbs that never have a dative
# reflexive are listed ("ich kaufe mir", "ich merke mir" are right).
expr verb [freue, interessiere, erinnere, beeile, verliebe, bedanke, entschuldige, kümmere, wundere, schäme, gewöhne, konzentriere, verabschiede, bewerbe, verabrede, ärgere, langweile, erkälte, verspäte, beschwere, verlasse, irre]

expr main <[(ich @verb mir), (@verb ich mir)], mir>

let message "Dieses Verb verlangt das Reflexivpronomen im Akkusativ: »mich« statt »mir«."
let description "Ersetzt »mir« durch »mich« bei Verben mit Akkusativ-Reflexiv (sich freuen, sich interessieren …)."
let kind "Grammar"
let becomes "mich"
let strategy "MatchCase"

test "Ich interessiere mir für Kunst." "Ich interessiere mich für Kunst."
test "Ich freue mir auf das Wochenende." "Ich freue mich auf das Wochenende."
test "Morgen beeile ich mir." "Morgen beeile ich mich."
test "Ich erinnere mir nicht." "Ich erinnere mich nicht."
test "Ich bedanke mir für die Hilfe." "Ich bedanke mich für die Hilfe."

allows "Ich interessiere mich für Kunst."
allows "Ich kaufe mir ein Buch."
allows "Ich merke mir das."
allows "Das freut mich."
