# A plural built with "-s" or "-e" where the noun has its own: "Visa".
expr main Visas

let message "Der Plural heißt »Visa«."
let description "Korrigiert den falsch gebildeten Plural »Visas« zu »Visa«."
let kind "Grammar"
let becomes "Visa"
let strategy "MatchCase"

test "Wir brauchen Visas." "Wir brauchen Visa."

allows "Wir brauchen Visa."
